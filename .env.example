# Yerel gelistirme sablonu. Kopyalayin:  cp .env.example .env
#
# .env git'e GIRMEZ. Canli degerler .env.production dosyasinda ve Netlify
# build'inde kullaniliyor.
#
# VITE_ onekli her degisken BUILD SIRASINDA bundle'a gomulur ve tarayiciya
# gider - buraya gizli anahtar (API secret, servis hesabi) yazmayin.

VITE_API_URL=http://127.0.0.1:8003/api
VITE_API_BASE_URL=http://127.0.0.1:8003/api
VITE_RECAPTCHA_SITE_KEY=

# Jeton Magazasi: misafire (girissiz) Kesif Koleksiyonu vitrinini gosterir. Sunucu bayragi
# (GAME_SHOP_KESIF1) acildiktan ve web yayinlandiktan sonra 1 yapin; varsayilan kapali.
VITE_SHOP_KESIF_GUEST=
